{
  "name": "debchroot-action",
  "version": "2.0.0",
  "description": "Cross-distribution rootfs creation and chroot execution for GitHub Actions",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node20 --outfile=dist/index.js",
    "dev": "esbuild src/main.ts --bundle --platform=node --target=node20 --outfile=dist/index.js",
    "clean": "rm -rf dist",
    "all": "npm run clean && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check src && eslint src",
    "lint:fix": "biome check --write src && eslint --fix src",
    "format": "biome format --write src",
    "format:check": "biome format src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NekoSekaiMoe/debchroot.git"
  },
  "keywords": [
    "github-actions",
    "chroot",
    "debootstrap",
    "rootfs",
    "cross-architecture"
  ],
  "author": "dabao1955",
  "license": "Apache-2.0",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/exec": "^1.1.1",
    "@actions/io": "^1.1.3",
    "@actions/tool-cache": "^2.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "esbuild": "^0.27.4",
    "eslint": "^10.0.3",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.57.1",
    "vitest": "^1.6.0"
  }
}
